{
  "mcpServers": {
    "vcollab-viewpoints": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/server/vp_server.py"
      ],
      "env": {
        "VCOLLAB_DIR": "${user_config.vcollab_dir}"
      }
    }
  }
}
